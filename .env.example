# Browser-safe values only. Never put promotion codes, payout gateway secrets,
# service-role keys or mTLS material in VITE_* variables.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Apps-in-Toss ad group IDs. Leave blank/REPLACE_ME until console issuance.
VITE_AIT_INTERSTITIAL_AD_GROUP_ID=REPLACE_ME
VITE_AIT_REWARDED_AD_GROUP_ID=REPLACE_ME
VITE_AIT_BANNER_AD_GROUP_ID=REPLACE_ME

# QA-only local flow. A production release must set this to false.
VITE_QA_PREVIEW=true

# Server-only values belong in Supabase Edge Function secrets, NOT here:
# AIT_APP_NAME=waterdrop
# TOSS_LIVE_PROMOTION_CODE=REPLACE_ME
# TOSS_TEST_PROMOTION_CODE=REPLACE_ME
# WATERDROP_PAYOUT_GATEWAY_URL=https://REPLACE_ME
# WATERDROP_PAYOUT_GATEWAY_SECRET=REPLACE_ME
# ADDITIONAL_ALLOWED_ORIGINS=https://REPLACE_ME
